NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

TWILIO_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# For testing, put your personal mobile number here (with country code, e.g., +1234567890)
# Twilio trial accounts can only send messages to verified numbers!
CFO_PHONE_NUMBER=your_personal_phone_number_here

# Legal/operator identity must be supplied by the ClearWire operator before public use.
CLEARWIRE_LEGAL_ENTITY_NAME=
CLEARWIRE_PRIVACY_EMAIL=
CLEARWIRE_BUSINESS_ADDRESS=

# Optional app origin for email links.
NEXT_PUBLIC_APP_URL=https://your-clearwire-domain.example
NEXT_PUBLIC_SITE_URL=https://your-clearwire-domain.example

# Server-side integrations (keep secrets server-only).
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
